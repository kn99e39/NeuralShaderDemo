    "roi_definitions": ["scarf_segment_interaction", "local_bend_control", "newly_exposed_surface", "non_target_lower_top"],
    "descriptors": ["FK-Scarf1_local_X_degrees", "FK-Scarf2_local_X_degrees", "FK-Scarf3_local_X_degrees", "cross_segment_distance"]
  }
