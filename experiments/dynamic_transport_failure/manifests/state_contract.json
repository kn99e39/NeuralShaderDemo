{
  "schema_version": 1,
  "global_contract": {
    "preserve": ["materials", "textures", "topology", "vertex_identity", "uv", "camera", "primary_lighting", "renderer", "rna_architecture", "canonical_checkpoint"],
    "change_only": ["geometry_pose"],
    "selection_rule": "States are predeclared. No state may be added, removed, or re-parameterized after viewing frozen-RNA error."
  },
  "character_einar_v1": {
    "trajectory": "Right arm moves from separated pose toward torso using the named production rig controls. Exact sign is validated from a non-evidence viewport preview before data generation; the listed magnitudes remain fixed thereafter.",
    "pose_controls": ["FK-UpperArm.R", "FK-Forearm.R", "IK-Wrist.R"],
    "states": [
      {"id": "P0", "label": "separated canonical", "upper_arm_delta_degrees": 0, "forearm_delta_degrees": 0, "expected_role": "baseline gap"},
      {"id": "P1", "label": "moderate articulation", "upper_arm_delta_degrees": 18, "forearm_delta_degrees": 12, "expected_role": "approach begins"},
      {"id": "P2", "label": "cross-part approach", "upper_arm_delta_degrees": 36, "forearm_delta_degrees": 28, "expected_role": "reduced arm-torso gap"},
      {"id": "P3", "label": "near-contact", "upper_arm_delta_degrees": 52, "forearm_delta_degrees": 42, "expected_role": "narrow gap/cavity"},
      {"id": "P4", "label": "stable contact if collision-free", "upper_arm_delta_degrees": 60, "forearm_delta_degrees": 50, "expected_role": "contact or closest valid configuration"}
    ],
    "roi_definitions": ["arm_torso_gap", "elbow_or_armpit_cavity", "newly_occluded_region", "newly_exposed_region"],
    "descriptors": ["upper_arm_angle_degrees", "forearm_angle_degrees", "minimum_arm_torso_distance"]
  },
  "cloth_rain_v2_garment_set": {
    "trajectory": "Historical F0-F3 uses the production RIG-rain FK-Scarf2 and FK-Scarf3 local-X controls. After GT-only validation found no usable direct-visibility separation in the original attribution pose path, R0-R4 was redesigned exactly once before any frozen-RNA R render. The final attribution path uses opposing FK-Scarf2/FK-Scarf3 local-X bends and changes only pose geometry while retaining mesh data, materials, UVs, camera, lighting, renderer, checkpoint, and canonical feature identity.",
    "historical_states": [
      {"id": "F0", "label": "canonical open", "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 0},
      {"id": "F1", "label": "moderate two-link flexion", "FK-Scarf2_local_X_degrees": 32, "FK-Scarf3_local_X_degrees": -20},
      {"id": "F2", "label": "deep two-link flexion", "FK-Scarf2_local_X_degrees": 64, "FK-Scarf3_local_X_degrees": -48},
      {"id": "F3", "label": "strong two-link flexion", "FK-Scarf2_local_X_degrees": 86, "FK-Scarf3_local_X_degrees": -72}
    ],
    "attribution_states": [
      {"id": "R0", "label": "separated canonical relation", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 0},
      {"id": "R1", "label": "low interaction opposing-bend control", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 45, "FK-Scarf3_local_X_degrees": -45},
      {"id": "R2", "label": "moderate validated approach", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 90, "FK-Scarf3_local_X_degrees": -90},
      {"id": "R3", "label": "strong validated approach", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 135, "FK-Scarf3_local_X_degrees": -135},
      {"id": "R4", "label": "closest validated pre-contact relation", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 180, "FK-Scarf3_local_X_degrees": -180}
    ],
    "fixed_target_nonlocal_states": [
      {"id": "N0", "label": "fixed-target baseline / far relation", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 0},
      {"id": "N1", "label": "remote-motion control", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 90},
      {"id": "N2", "label": "moderate approach", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 135},
      {"id": "N3", "label": "narrow-gap approach", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 165},
      {"id": "N4", "label": "closest sampled pre-contact relation", "FK-Scarf1_local_X_degrees": 0, "FK-Scarf2_local_X_degrees": 0, "FK-Scarf3_local_X_degrees": 180}
    ],
    "fixed_target_contract": {
      "target_mesh": "GEO-rain_scarf",
